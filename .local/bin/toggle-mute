#!/usr/bin/env bash

# get all pids associated with a process
tree() {
    local child
    echo "$1"
    for child in $(pgrep -P "$1"); do
        tree "$child"
    done
}

# get pid of active window
pid=$(
    swaymsg -t get_tree -r |
    jq -e 'first(.. | select(.focused? == true) | .pid // empty)'
) || exit 1

{ pactl -f json list clients; pactl -f json list sink-inputs; } |
jq -r '
    map(select(.properties["application.process.id"] | IN($ARGS.positional[])) | .index | tostring) as $clients
    | input
    | map(select(.client | IN($clients[])))
    | (if .[0].mute then 0 else 1 end) as $state
    | .[] | "\(.index) \($state)"
' --args $(tree "$pid") |
while read -r index state; do
    pactl set-sink-input-mute "$index" "$state"
done
